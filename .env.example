# Password enkripsi TAS (wajib) — ganti dengan password kuat kamu sendiri
TAS_PASSWORD=GANTI_DENGAN_PASSWORD_KUAT

# --- Auth web (opsional tapi SANGAT disarankan — web kebuka publik) ---
# Kosongkan AUTH_PASSWORD untuk mode tanpa login (tidak disarankan)
AUTH_USER=admin
AUTH_PASSWORD=GANTI_DENGAN_PASSWORD_WEB

# --- Kunci enkripsi secret-at-rest (opsional) ---
# Dipakai mengenkripsi password bot & secret S3 di SQLite.
# Kalau kosong, kunci dibuat otomatis di /data/.master.key (pertahankan file itu —
# kalau hilang, password/secret lama tidak bisa didekripsi).
# TAS_MASTER_KEY=

# --- Upload via Telegram bot (opsional) ---
# Kirim file ke bot TAS → otomatis masuk storage & muncul di list web,
# pesan asli dihapus setelah tersimpan. Limit 20MB (batas Bot API).
# Token bot otomatis didekripsi dari config.json profile (pakai TAS_PASSWORD).
# BOT_INGEST=1  (0 = matikan)
# TAS_BOT_TOKEN=  (override manual, kalau dekripsi otomatis gagal)
