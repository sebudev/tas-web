# deps
node_modules/
frontend/node_modules/
frontend/dist/

# env & secrets
.env

# runtime data (SQLite, storage index, uploads, cache)
data/
tmp/

# build output frontend (dibangun ulang oleh Dockerfile)
/public/
# allow frontend public assets (favicon etc) — vite copies frontend/public/* → dist/*
!frontend/public/
!frontend/public/**

# log & os
*.log
.DS_Store
